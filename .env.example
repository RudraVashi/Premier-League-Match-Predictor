# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: override default Gemini model
GEMINI_MODEL=gemini-flash-lite-latest

# Set to 1 to attempt FBref possession scrape (needs browser driver; off by default)
EPL_FETCH_FBREF=0

# Free key for live/pre-match odds on upcoming fixtures: https://the-odds-api.com/
THE_ODDS_API_KEY=your_api_key_here
# Cache live odds locally to save free-tier credits (seconds). Default 2700 = 45 min.
ODDS_CACHE_TTL_SEC=2700